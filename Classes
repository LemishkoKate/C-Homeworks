using System.Text;
using System.Text.RegularExpressions;

namespace Classes
{
    internal class Program
    {
//1
        struct Vector3
        {
            public double X;
            public double Y;
            public double Z;

            public Vector3(double x, double y, double z)
            {
                X = x;
                Y = y;
                Z = z;
            }

            public Vector3 Add(Vector3 b)
            {
                return new Vector3(X + b.X, Y + b.Y, Z + b.Z);
            }

            public Vector3 Sub(Vector3 b)
            {
                return new Vector3(X - b.X, Y - b.Y, Z - b.Z);
            }

            public Vector3 Mul(double k)
            {
                return new Vector3(X * k, Y * k, Z * k);
            }

            public override string ToString()
            {
                return $"({X}, {Y}, {Z})";
            }
        }
        //2
        struct DecimalNumber
        {
            public int Value;

            public DecimalNumber(int v)
            {
                Value = v;
            }

            public string ToBinary()
            {
                return Convert.ToString(Value, 2);
            }

            public string ToOctal()
            {
                return Convert.ToString(Value, 8);
            }

            public string ToHex()
            {
                return Convert.ToString(Value, 16).ToUpper();
            }
        }

        struct RGB
        {
            public int R;
            public int G;
            public int B;

            public RGB(int r, int g, int b)
            {
                R = r; G = g; B = b;
            }

            public string ToHEX()
            {
                return $"#{R:X2}{G:X2}{B:X2}";
            }

            public string ToCMYK()
            {
                double r = R / 255.0;
                double g = G / 255.0;
                double b = B / 255.0;

                double k = 1 - Math.Max(r, Math.Max(g, b));
                double c = (1 - r - k) / (1 - k);
                double m = (1 - g - k) / (1 - k);
                double y = (1 - b - k) / (1 - k);

                if (k == 1) { c = 0; m = 0; y = 0; }

                return $"C:{c:F2} M:{m:F2} Y:{y:F2} K:{k:F2}";
            }

            public string ToHSL()
            {
                double r = R / 255.0;
                double g = G / 255.0;
                double b = B / 255.0;

                double max = Math.Max(r, Math.Max(g, b));
                double min = Math.Min(r, Math.Min(g, b));

                double h = 0;
                double s;
                double l = (max + min) / 2;

                if (max == min)
                {
                    h = 0;
                    s = 0;
                }
                else
                {
                    double diff = max - min;

                    s = l > 0.5 ? diff / (2 - max - min) : diff / (max + min);

                    if (max == r) h = (g - b) / diff + (g < b ? 6 : 0);
                    else if (max == g) h = (b - r) / diff + 2;
                    else h = (r - g) / diff + 4;

                    h *= 60;
                }

                return $"H:{h:F1} S:{s:F2} L:{l:F2}";
            }
        }


        static void Main(string[] args)
        {
//1
            Vector3 v1 = new Vector3(1, 2, 3);
            Vector3 v2 = new Vector3(2, 3, 4);

            Console.WriteLine(v1.Add(v2));
            Console.WriteLine(v1.Sub(v2));
            Console.WriteLine(v1.Mul(2));

            Console.WriteLine(); 
//2     
            DecimalNumber n = new DecimalNumber(255);

            Console.WriteLine(n.ToBinary());
            Console.WriteLine(n.ToOctal());
            Console.WriteLine(n.ToHex());

            Console.WriteLine();
//3
            RGB c = new RGB(255, 128, 0);

            Console.WriteLine(c.ToHEX());
            Console.WriteLine(c.ToHSL());
            Console.WriteLine(c.ToCMYK());
        }
    }
}
